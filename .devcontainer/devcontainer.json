{
    "name": "AI Development Environment",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "dev",
    "workspaceFolder": "/workspace",
    "customizations": {
        "vscode": {
            "extensions": [
                "github.copilot",
                "github.copilot-chat",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "eamodio.gitlens",
                "yzhang.markdown-all-in-one",
                "GitHub.vscode-pull-request-github"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "git.autofetch": true,
                "python.defaultInterpreterPath": "/usr/bin/python3"
            }
        }
    },
    "mounts": [
        "source=${localEnv:HOME}/.ssh,target=/home/developer/.ssh-local,type=bind,readonly",
        "source=${env:SSH_AUTH_SOCK},target=${env:SSH_AUTH_SOCK},type=bind"
    ],
    "containerEnv": {
        "SSH_AUTH_SOCK": "${localEnv:SSH_AUTH_SOCK}",
        "GIT_AUTHOR_NAME": "${localEnv:GIT_AUTHOR_NAME}",
        "GIT_AUTHOR_EMAIL": "${localEnv:GIT_AUTHOR_EMAIL}",
        "LANG": "ru_RU.UTF-8",
        "LC_ALL": "ru_RU.UTF-8",
        "LANGUAGE": "ru_RU:ru"
    },
    "remoteUser": "developer",
    "postCreateCommand": "bash /usr/local/bin/ssh-setup.sh developer"
}
