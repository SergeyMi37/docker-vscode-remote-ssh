# Настройки пользователя
DEV_USER=developer
DEV_UID=1000
DEV_GID=1000
USER_PASSWORD=T0p-5ec

# Git настройки
GIT_AUTHOR_NAME="Your Name"
GIT_AUTHOR_EMAIL="your.email@example.com"

# Forgejo настройки
FORGEJO_URL=http://host.docker.internal:3000
FORGEJO_TOKEN=your_forgejo_token_here
FORGEJO_USERNAME=dev

# SSH Agent (обычно не требует настройки)
SSH_AUTH_SOCK=${SSH_AUTH_SOCK:-/run/user/1000/keyring/ssh}

# Ollama настройки
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_API_URL=http://host.docker.internal:11434/api

# Порт для тестирования (можно менять)
SERVICE_PORT=8000
